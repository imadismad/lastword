+// FIDO2 shrunk by 3 slots (was 9-30) to carve a dedicated LASTWORD range.
+// On a vierge badge no FIDO2 credential lives in 28-30, so nothing is lost.
 #define ECC_SLOT_MOD_FIDO2_START 9
-#define ECC_SLOT_MOD_FIDO2_END 30
+#define ECC_SLOT_MOD_FIDO2_END 27
+// mod_lastword owns 3 P-256 slots: stock=28, DAF=29, duress=30. Keys are
+// generated in-chip at first boot and never leave the TROPIC01.
+#define ECC_SLOT_MOD_LASTWORD_START 28
+#define ECC_SLOT_MOD_LASTWORD_END 30
 // Plugin ECC pool (single reserved slot, the last physical ECC slot).
 #define ECC_SLOT_MOD_PLUGINS_START 31
