# Copy to .env (gitignored) and fill in. NEVER commit the real .env.
# AWS sandbox (temporary STS credentials)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Chain
LASTWORD_RPC_URL=http://127.0.0.1:8545
LASTWORD_CHAIN_ID=31337
LASTWORD_CONTRACT_ADDRESS=

# Bridge agent key (gas only, no approval power)
BRIDGE_PRIVATE_KEY=

# Badge transport. BRIDGE_TRANSPORT is the one active at startup; the Live demo tab
# toggles between SIM (TCP badge-sim, no radio) and REAL (LoRa mesh to the HP badge).
BRIDGE_TRANSPORT=tcp:127.0.0.1:8766
BRIDGE_SIM_TRANSPORT=tcp:127.0.0.1:8766
BRIDGE_REAL_TRANSPORT=mesh:COM8

# Dashboard: which Dell nugget the Live demo tab shows live mesh status for
LW_MESH_DEV=COM8

# Bedrock
BEDROCK_MODEL_ID=
BEDROCK_GUARDRAIL_ID=
